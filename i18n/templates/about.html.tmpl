<!DOCTYPE html>
<html lang="{{lang}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{t.about.title}}</title>
<meta name="description" content="{{t.about.meta_description}}">
<link rel="icon" href="{{prefix}}assets/favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{prefix}}assets/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="{{prefix}}assets/apple-touch-icon.png">
<link rel="alternate" hreflang="en" href="{{page_url_en}}">
<link rel="alternate" hreflang="es" href="{{page_url_es}}">
<link rel="alternate" hreflang="x-default" href="{{page_url_en}}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Saving Vista School">
<meta property="og:url" content="{{page_url_self}}">
<meta property="og:title" content="{{t.about.title}}">
<meta property="og:description" content="{{t.about.meta_description}}">
<meta property="og:image" content="https://savingvistaschool.org/assets/social-preview.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{t.about.title}}">
<meta name="twitter:description" content="{{t.about.meta_description}}">
<meta name="twitter:image" content="https://savingvistaschool.org/assets/social-preview.png">
<link rel="stylesheet" href="{{prefix}}style.css">
</head>
<body>

<header class="site-header">
  <div class="container">
    <a class="brand" href="index.html">
      <svg class="brand-icon" width="30" height="30" viewBox="0 0 200 200" fill="none" aria-hidden="true">
        <circle cx="90" cy="68" r="20" stroke="#fff" stroke-width="9"/>
        <path d="M55 166 Q55 108 90 108 Q118 108 122 140" stroke="#fff" stroke-width="9" stroke-linecap="round"/>
        <path d="M113 118 Q136 104 149 82" stroke="#fff" stroke-width="9" stroke-linecap="round"/>
        <polygon points="152.3,28.7 161.2,41.6 176.5,38.0 167.0,50.5 175.1,63.8 160.3,58.7 150.1,70.5 150.5,54.9 136.0,48.8 151.0,44.3" fill="var(--gold)"/>
        <polygon points="34.0,161.0 36.5,168.5 44.5,168.6 38.1,173.3 40.5,180.9 34.0,176.3 27.5,180.9 29.9,173.3 23.5,168.6 31.5,168.5" fill="var(--gold)"/>
      </svg>
      Saving Vista School
    </a>
    <button type="button" class="nav-toggle" aria-label="{{t.common.nav.toggle_aria}}" aria-expanded="false" aria-controls="primary-nav">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <nav class="main-nav" id="primary-nav">
      <ul>
        <li><a href="index.html">{{t.common.nav.home}}</a></li>
        <li><a href="letters.html">{{t.common.nav.letters}}</a></li>
        <li><a href="policies.html">{{t.common.nav.policies}}</a></li>
        <li><a href="meetings.html">{{t.common.nav.meetings}}</a></li>
        <li><a href="about.html" class="active">{{t.common.nav.about}}</a></li>
                <li class="lang-switcher">
          <a class="lang-switcher-link" href="{{other_page_url}}" hreflang="{{other_lang}}" lang="{{other_lang}}" aria-label="{{t.common.nav.lang_switch_aria}}">
            <span class="lang-flag-circle">{{own_flag_svg}}</span>
            <svg class="lang-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            <span class="lang-divider" aria-hidden="true"></span>
            <span class="lang-flag-circle">{{other_flag_svg}}</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<div class="disclaimer-bar">
  <div class="container">
    {{t.common.disclaimer}}
  </div>
</div>

<main>

<div class="page-header">
  <div class="container">
        <svg class="page-header-graphic" width="104" height="104" viewBox="0 0 200 200" fill="none" aria-hidden="true">
      <rect x="30" y="45" width="140" height="90" rx="20" stroke="#fff" stroke-width="4"/>
      <polygon points="70,135 58,160 92,135" fill="#fff"/>
      <polygon points="172.0,21.0 174.9,30.0 184.4,30.0 176.8,35.5 179.6,44.5 172.0,39.0 164.4,44.5 167.2,35.5 159.6,30.0 169.1,30.0" fill="var(--gold)"/>
      <polygon points="30.0,169.0 32.1,175.2 38.6,175.2 33.3,179.1 35.3,185.3 30.0,181.5 24.7,185.3 26.7,179.1 21.4,175.2 27.9,175.2" fill="var(--gold)"/>
    </svg>
    <h1>{{t.about.h1}}</h1>
    <p>{{t.about.subhead}}</p>
  </div>
</div>

<section id="contact">
  <div class="container contact-grid">

    <div class="contact-info">
      <h2>{{t.about.section_about_heading}}</h2>
      <p style="color:var(--muted);">
        {{t.about.section_about_body}}
      </p>

      <h2>{{t.about.section_mission_heading}}</h2>
      <p style="color:var(--muted);">
        {{t.about.section_mission_body}}
      </p>

      <dl>
        <dt>{{t.about.email_label}}</dt>
        <dd><a href="mailto:savingvistaschool@gmail.com">savingvistaschool@gmail.com</a></dd>
      </dl>
    </div>

    <form class="simple-form" action="https://formsubmit.co/savingvistaschool@gmail.com" method="POST">
      <input type="hidden" name="_subject" value="{{t.about.form_subject}}">
      <input type="hidden" name="_next" value="{{form_next_url}}">
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
      <h2 style="margin:0;">{{t.about.form_heading}}</h2>
      <div>
        <label for="name">{{t.about.form_label_name}}</label>
        <input type="text" id="name" name="name" required>
      </div>
      <div>
        <label for="email">{{t.about.form_label_email}}</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div>
        <label for="message">{{t.about.form_label_message}}</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>
      <button type="submit">{{t.about.form_button}}</button>
      <p class="form-note">
        {{t.about.form_note_privacy}}
      </p>
      <p class="form-note" id="sent-confirmation" style="display:none;">
        {{t.about.form_note_sent}}
      </p>
    </form>

  </div>
</section>

<section class="alt">
  <div class="container" style="text-align:center;">
    <h2>{{t.about.alt_heading}}</h2>
    <p style="color:var(--muted);max-width:600px;margin:0 auto 22px;">
      {{t.about.alt_body}}
    </p>
    <div class="hero-actions">
      <a class="btn-primary" href="letters.html#submit-a-letter">{{t.about.alt_btn_submit}}</a>
      <a class="btn-outline" href="about.html#contact">{{t.about.alt_btn_contact}}</a>
    </div>
  </div>
</section>

</main>

<footer class="site-footer">
  <div class="container">
    &copy; <span id="year"></span> Saving Vista School. {{t.common.footer_rights}}
  </div>
</footer>

<script>
document.getElementById('year').textContent = new Date().getFullYear();
if (new URLSearchParams(window.location.search).get('sent') === '1') {
  var el = document.getElementById('sent-confirmation');
  if (el) { el.style.display = 'block'; }
}
</script>
<script src="{{prefix}}assets/js/nav.js" defer></script>
</body>
</html>
